# Copy to a private /etc/daling-wechat.env or another ignored file.
# Never commit the filled file, database, app Secret or bridge Secret.
DALING_SITE_URL=https://daling-ai-matching-smile.harebod.chatgpt.site
# Same >=43-character secret as the Site; recommended 32 random bytes base64url.
DALING_WECHAT_BRIDGE_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_THE_SITE
WECHAT_CORP_ID=REPLACE_WITH_CORP_ID
# New integrations use an authorized custom application's Secret.
WECHAT_APP_SECRET=REPLACE_WITH_CUSTOM_APPLICATION_SECRET
WECHAT_OPEN_KFID=REPLACE_WITH_CUSTOMER_SERVICE_ACCOUNT_ID
# Token: 1-32 English letters / numbers. Matches callback settings.
WECHAT_TOKEN=REPLACE_WITH_CALLBACK_TOKEN
# Exactly 43 characters; use the value from callback settings.
WECHAT_ENCODING_AES_KEY=REPLACE_WITH_43_CHARACTER_CALLBACK_AES_KEY
WECHAT_HOST=127.0.0.1
WECHAT_PORT=8788
WECHAT_DB_PATH=/var/lib/daling-wechat/relay.sqlite
# Optional ISO UTC time or Unix seconds. On first startup only.
# Empty means current startup time; persisted thereafter to avoid replaying history.
WECHAT_START_AT=
