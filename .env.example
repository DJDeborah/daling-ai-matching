# Copy to .env.local and set a server-side DeepSeek key.
# Never put this value in NEXT_PUBLIC_* or commit .env.local.
DEEPSEEK_API_KEY=replace_with_your_deepseek_key

# Optional WeChat customer-service bridge. Leave disabled until a fixed-egress
# relay is configured and verified; Tencent application Secret stays on relay.
WECHAT_ENABLED=false
WECHAT_CORP_ID=replace_with_corp_id
WECHAT_OPEN_KFID=replace_with_customer_service_account_id
DALING_WECHAT_BRIDGE_SECRET=replace_with_32_random_bytes_base64url
